m":41,"lat":40.765395,"lng":-73.975573},{"km":42,"lat":40.771023,"lng":-73.978183}],"landmarks":[{"km":0.0,"name":"Largada · Fort Wadsworth","note":"Staten Island, al pie del Verrazzano-Narrows. Las tres olas (azul, naranja, verde) salen por carriles distintos del puente y se unifican en Brooklyn cerca del km 13.","lat":40.60188,"lng":-74.06112},{"km":1.6,"name":"Punto más alto · Verrazzano-Narrows","note":"La cima del puente, unos 80 m sobre el agua, es el punto más alto del recorrido. Primer kilómetro y medio en subida, luego un descenso largo hasta Bay Ridge.","lat":40.606958,"lng":-74.043432},{"km":3.6,"name":"Entrada a Brooklyn · Bay Ridge","note":"Fin del puente. Empiezan los vecindarios y el público: Fourth Avenue es una recta de casi 10 km hacia el norte.","lat":40.616767,"lng":-74.027218},{"km":12.4,"name":"Barclays Center · Lafayette Avenue","note":"Zona de Atlantic Avenue y Barclays Center. Poco después, en Lafayette, se juntan las tres olas de largada.","lat":40.683535,"lng":-73.97897},{"km":17.5,"name":"Williamsburg · Bedford Avenue","note":"Tramo silencioso por el barrio jasídico de Williamsburg, después Greenpoint.","lat":40.711514,"lng":-73.963191},{"km":21.1,"name":"Media maratón · Puente Pulaski","note":"El km 21.1 cae sobre el puente Pulaski, que cruza Newtown Creek de Brooklyn a Queens.","lat":40.73848,"lng":-73.953033},{"km":23.0,"name":"Long Island City","note":"Tramo corto por Queens: Vernon Boulevard y 44th Drive hacia el Queensboro.","lat":40.747684,"lng":-73.944977},{"km":24.6,"name":"Puente Queensboro","note":"Subida de más de un kilómetro sin público (no se admiten espectadores). La parte más dura del recorrido antes de la llegada.","lat":40.755597,"lng":-73.951841},{"km":26.0,"name":"Bajada a First Avenue","note":"La curva al salir del puente hacia First Avenue es famosa por el rugido del público. Desde acá, 6 km de recta hacia el norte con subidas suaves.","lat":40.761218,"lng":-73.960793},{"km":31.7,"name":"Puente Willis Avenue · Bronx","note":"Cruce del río Harlem al Bronx. Los famosos 20 millas: la zona donde suele aparecer el muro.","lat":40.80495,"lng":-73.926295},{"km":33.8,"name":"Puente Madison Avenue · vuelta a Manhattan","note":"Cruce de regreso a Manhattan por Harlem. Después, Fifth Avenue hacia el sur.","lat":40.814303,"lng":-73.934834},{"km":37.0,"name":"Fifth Avenue · Museum Mile","note":"Subida larga y sostenida entre la 110th y la 90th por el borde de Central Park. Engañosa: parece plana y no lo es.","lat":40.792226,"lng":-73.952614},{"km":38.1,"name":"Entrada a Central Park · Engineers' Gate (90th St)","note":"Ingreso al parque por East Drive. Colinas cortas en bajada neta hasta la salida por la 59th.","lat":40.783735,"lng":-73.959194},{"km":40.9,"name":"Central Park South","note":"Salida del parque en Grand Army Plaza y tramo por Central Park South, con las fachadas de los hoteles y el público más denso.","lat":40.764955,"lng":-73.974532},{"km":41.7,"name":"Columbus Circle · reingreso al parque","note":"Última curva y subida corta por West Drive hasta la llegada.","lat":40.768848,"lng":-73.980144},{"km":42.195,"name":"Llegada · Tavern on the Green (W 67th St)","note":"Meta en West Drive, a la altura de la calle 67, frente a Tavern on the Green.","lat":40.77238,"lng":-73.97676}]}},"practical":[],"findings":[]}